<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The engine's Python (Resources/engine/python/bin/python3.13) under the
     hardened runtime. Each one is needed; none is there "just in case". -->
<plist version="1.0">
<dict>
  <!-- The engine records the push-to-talk utterance itself (sounddevice). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- numba/llvmlite (a dependency of mlx-whisper) compile to machine code
       at run time, and MLX JIT-compiles its kernels. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Python loads its extension modules (.so) from pip wheels. They are
       re-signed by sign.sh, but the engine's .py files are not code-signed at
       all, so library validation would add no real protection here, only a
       way to break start-up on a wheel's signature quirk. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
